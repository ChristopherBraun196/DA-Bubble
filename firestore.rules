rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(chatId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(chatId);
        allow create: if signedIn() && isMember(chatId)
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn() && isMember(chatId)
          && (request.resource.data.text == resource.data.text
              || resource.data.authorId == request.auth.uid);
        allow delete: if false;
      }
    }
  }
}
